# === Anthropic ===
ANTHROPIC_API_KEY=

# === Supabase (used as a database only — server-side) ===
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# === Swiggy MCP ===
SWIGGY_BASE_URL=https://mcp.swiggy.com
SWIGGY_REDIRECT_URI=http://localhost:3000/api/auth/swiggy/callback
# No client id or secret to set — Swiggy issues one via Dynamic Client
# Registration, handled automatically in lib/swiggy/dcr.js.

# === Secrets ===
# Encrypts the stored Swiggy access token. Changing it invalidates
# existing sessions and everyone signs in again.
#   openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Signs the app's own session cookie.
#   openssl rand -base64 32
SESSION_SECRET=
